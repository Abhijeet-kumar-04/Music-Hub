<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= categoryName %> Playlists | Music App</title>
    <link rel="stylesheet" href="/css/style_dashboard.css"> 

</head>
<body>
    <div class="dashboard-container">
        <%- include('partials/sidebar') %>

        <main class="main-content">
            <%- include('partials/header') %>
            
            <section class="content-area">
                <div class="playlist-section">
                    <h2><%= categoryName %></h2>
                    <div class="playlist-grid" id="playlistGrid">
                        <% playlists.forEach(playlist => { %>
                            <% if (playlist) { %>
                                <a href="/playlist/<%= playlist.id %>" class="playlist-card-link">
                                    <div class="playlist-card">
                                        <% if (playlist.images && playlist.images.length > 0) { %>
                                            <img src="<%= playlist.images[0].url %>" alt="<%= playlist.name %> Cover">
                                        <% } %>
                                        <div class="card-text-content">
                                            <h4><%= playlist.name %></h4>
                                            <p><%- playlist.description %></p>
                                        </div>
                                    </div>
                                </a>
                            <% } %>
                        <% }); %>
                    </div>
                </div>
                <!-- NEW: Load More Button -->
                <div class="load-more-container">
                    <button id="loadMoreBtn">Load More</button>
                </div>
            </section>
        </main>
    </div>

    <!-- NEW: JavaScript for Load More functionality -->
    <script>
        // Dropdown menu logic
        function toggleDropdown() {
            document.getElementById("myDropdown").classList.toggle("show");
        }
        window.onclick = function(event) {
            if (!event.target.matches('.profile-button, .profile-button *')) {
                var dropdowns = document.getElementsByClassName("dropdown-content");
                for (var i = 0; i < dropdowns.length; i++) {
                    if (dropdowns[i].classList.contains('show')) {
                        dropdowns[i].classList.remove('show');
                    }
                }
            }
        }

        // Load More logic
        const loadMoreBtn = document.getElementById('loadMoreBtn');
        const playlistGrid = document.getElementById('playlistGrid');
        let currentOffset = 20; // We already loaded the first 20 items

        loadMoreBtn.addEventListener('click', async () => {
            // Get the category ID from the current URL
            const urlParts = window.location.pathname.split('/');
            const categoryId = urlParts[urlParts.length - 1];

            // Fetch the next set of playlists from our new API route
            const response = await fetch(`/api/category/${categoryId}/playlists?offset=${currentOffset}`);
            const newPlaylists = await response.json();

            if (newPlaylists && newPlaylists.length > 0) {
                newPlaylists.forEach(playlist => {
                    if (playlist) {
                        // Create the new card element dynamically
                        const cardLink = document.createElement('a');
                        cardLink.href = `/playlist/${playlist.id}`;
                        cardLink.className = 'playlist-card-link';

                        let imageHtml = '';
                        if (playlist.images && playlist.images.length > 0) {
                            imageHtml = `<img src="${playlist.images[0].url}" alt="${playlist.name} Cover">`;
                        }

                        cardLink.innerHTML = `
                            <div class="playlist-card">
                                ${imageHtml}
                                <div class="card-text-content">
                                    <h4>${playlist.name}</h4>
                                    <p>${playlist.description}</p>
                                </div>
                            </div>
                        `;
                        playlistGrid.appendChild(cardLink);
                    }
                });
                // Increase the offset for the next click
                currentOffset += 20;
            } else {
                // If no more playlists are returned, hide the button
                loadMoreBtn.textContent = 'No More Playlists';
                loadMoreBtn.disabled = true;
            }
        });
    </script>

    <!-- search baar  -->
    <script>
        // Search bar logic
        const searchInput = document.querySelector('.search-bar input');
        searchInput.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
                const query = searchInput.value;
                if (query.trim() !== '') {
                    window.location.href = `/search?q=${encodeURIComponent(query)}`;
                }
            }
        });

        // Dropdown logic
        function toggleDropdown() {
            document.getElementById("myDropdown").classList.toggle("show");
        }
        window.onclick = function(event) {
            if (!event.target.matches('.profile-button, .profile-button *')) {
                var dropdowns = document.getElementsByClassName("dropdown-content");
                for (var i = 0; i < dropdowns.length; i++) {
                    if (dropdowns[i].classList.contains('show')) {
                        dropdowns[i].classList.remove('show');
                    }
                }
            }
        }
    </script>
</body>
</html>