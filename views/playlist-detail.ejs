<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= playlist.name %> | Music App</title>
    <link rel="stylesheet" href="/css/style_dashboard.css">
    <style>
        .playlist-header {
            display: flex;
            align-items: flex-end;
            gap: 24px;
            margin-bottom: 30px;
            padding: 20px;
            background: linear-gradient(180deg, rgba(212, 175, 55, 0.08) 0%, rgba(4, 9, 18, 0) 100%);
            border-radius: 12px;
            border: 1px solid var(--border-gold);
        }
        .playlist-header img {
            width: 190px;
            height: 190px;
            object-fit: cover;
            border-radius: 12px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.5);
            border: 1px solid var(--border-gold);
        }
        .playlist-header-info h1 {
            font-size: 2.8rem;
            margin: 0 0 10px;
            font-weight: 800;
        }
        .playlist-header-info p {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin: 0;
        }
    </style>
    <link rel="icon" href="/images/favicon.png">
</head>
<body>
    <div class="dashboard-container">
        <%- include('partials/sidebar') %>
        <main class="main-content">
            <%- include('partials/header') %>
            
            <section class="content-area">
                <div class="playlist-header">
                    <img src="<%= playlist.images[0]?.url || '/images/default-cover.png' %>" alt="Playlist Cover">
                    <div class="playlist-header-info">
                        <p>PLAYLIST</p>
                        <h1><%= playlist.name %></h1>
                        <p><%= playlist.description || 'No description' %></p>
                    </div>
                </div>

                <% if (playlist.tracks && playlist.tracks.items && playlist.tracks.items.length > 0) { %>
                    <table class="song-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Title</th>
                                <th>Album</th>
                                <th style="text-align: right; width: 350px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% playlist.tracks.items.forEach((item, index) => { %>
                                <% if (item.track) { %>
                                    <% const trackId = item.track.isLocal ? item.track.id : item.track.id; %>
                                    <tr data-track-id="<%= trackId %>">
                                        <td style="width: 50px;">
                                            <span class="song-index-num"><%= index + 1 %></span>
                                            <div class="song-play-wave playing-wave-container">
                                                <div class="playing-wave-bar"></div>
                                                <div class="playing-wave-bar"></div>
                                                <div class="playing-wave-bar"></div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="song-title-cell">
                                                <img src="<%= item.track.album?.images[2]?.url || item.track.album?.images[0]?.url || 'https://placehold.co/40x40/3A6073/FFFFFF?text=Song' %>" alt="Cover">
                                                <div>
                                                    <div class="song-title"><%= item.track.name %></div>
                                                    <div class="song-artist"><%= item.track.artists?.map(a => a.name).join(', ') || 'Unknown Artist' %></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><%= item.track.album?.name || 'Single' %></td>
                                        <td class="actions-cell">
                                            <!-- Play Button -->
                                            <button class="play-row-btn" onclick="playTrack({
                                                id: '<%= trackId %>',
                                                name: '<%= item.track.name ? item.track.name.replace(/'/g, "\\'") : "" %>',
                                                artist: '<%= item.track.artists ? item.track.artists.map(a => a.name).join(", ").replace(/'/g, "\\'") : "" %>',
                                                coverUrl: '<%= item.track.album && item.track.album.images && item.track.album.images.length > 0 ? item.track.album.images[0].url : "" %>',
                                                audioUrl: '<%= item.track.audioUrl || "" %>',
                                                spotifyId: '<%= item.track.isLocal ? "" : item.track.id %>',
                                                isLocal: '<%= item.track.isLocal %>'
                                            })">Play</button>
 
                                            <% if (account.role === 'user') { %>
                                                <!-- Like Button -->
                                                <button class="like-row-btn" onclick="toggleLikeSong(this, {
                                                    songId: '<%= item.track.isLocal ? item.track.id : "" %>',
                                                    spotifyId: '<%= !item.track.isLocal ? item.track.id : "" %>',
                                                    title: '<%= item.track.name ? item.track.name.replace(/'/g, "\\'") : "" %>',
                                                    artist: '<%= item.track.artists ? item.track.artists.map(a => a.name).join(", ").replace(/'/g, "\\'") : "" %>',
                                                    album: '<%= item.track.album && item.track.album.name ? item.track.album.name.replace(/'/g, "\\'") : "" %>',
                                                    coverUrl: '<%= item.track.album && item.track.album.images && item.track.album.images.length > 0 ? item.track.album.images[0].url : "" %>',
                                                    isLocal: <%= item.track.isLocal ? 'true' : 'false' %>
                                                })">
                                                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                                                </button>
 
                                                <!-- Add to other playlist button -->
                                                <button class="add-playlist-btn" onclick="openAddToPlaylistModal({
                                                    songId: '<%= item.track.isLocal ? item.track.id : "" %>',
                                                    spotifyId: '<%= !item.track.isLocal ? item.track.id : "" %>',
                                                    title: '<%= item.track.name ? item.track.name.replace(/'/g, "\\'") : "" %>',
                                                    artist: '<%= item.track.artists ? item.track.artists.map(a => a.name).join(", ").replace(/'/g, "\\'") : "" %>',
                                                    album: '<%= item.track.album && item.track.album.name ? item.track.album.name.replace(/'/g, "\\'") : "" %>',
                                                    coverUrl: '<%= item.track.album && item.track.album.images && item.track.album.images.length > 0 ? item.track.album.images[0].url : "" %>',
                                                    isLocal: <%= item.track.isLocal ? 'true' : 'false' %>
                                                })">+ Add</button>
 
                                                <!-- Remove button if it is a local user playlist -->
                                                <% if (isLocalPlaylist && playlist.name !== 'Liked Songs') { %>
                                                    <button class="btn-remove" onclick="removeSongFromPlaylist('<%= playlist.id %>', '<%= item.track.isLocal ? item.track.id : item.track._id || item.track.id %>')">Remove</button>
                                                 <% } %>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% } %>
                            <% }); %>
                        </tbody>
                    </table>
                <% } else { %>
                    <div style="text-align: center; padding: 60px 20px; background: rgba(0,0,0,0.15); border-radius: 12px; border: 1px dashed rgba(255,255,255,0.1);">
                        <h3>Playlist is Empty</h3>
                        <p style="color: #b3b3b3; margin-bottom: 20px;">Add tracks by searching for music or browsing artists.</p>
                        <a href="/search?q=kesariya" class="play-row-btn" style="text-decoration: none;">Browse Songs</a>
                    </div>
                <% } %>
            </section>
        </main>
    </div>

    <script>
        async function removeSongFromPlaylist(playlistId, songId) {
            if (!confirm('Are you sure you want to remove this song from the playlist?')) return;
            try {
                const res = await fetch(`/playlists/${playlistId}/remove-song`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ songId })
                });
                const data = await res.json();
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert(data.error || 'Failed to remove song.');
                }
            } catch (err) {
                console.error(err);
                alert('Error removing song.');
            }
        }
    </script>
</body>
</html>