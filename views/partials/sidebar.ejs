<aside class="sidebar">
    <!-- Logo -->
    <div class="sidebar-logo">
        <span>Music<span style="color: var(--gold-primary);">Hub</span></span>
    </div>
    
    <!-- Main Navigation -->
    <h3 class="sidebar-section-label">Navigate</h3>
    <ul>
        <% const dashboardPath = `/${account.role}/${encodeURIComponent(account.name)}/dashboard`; %>
        <li class="<%= typeof currentPath !== 'undefined' && currentPath === dashboardPath ? 'active' : '' %>">
            <a href="<%= dashboardPath %>">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Home
            </a>
        </li>
        <li class="<%= typeof currentPath !== 'undefined' && currentPath === '/library/playlists' ? 'active' : '' %>">
            <a href="/library/playlists">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                My Library
            </a>
        </li>
        <li class="<%= typeof currentPath !== 'undefined' && currentPath === '/browse/artists' ? 'active' : '' %>">
            <a href="/browse/artists">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Browse Artists
            </a>
        </li>
        <% if (account.role === 'user') { %>
            <li class="<%= typeof currentPath !== 'undefined' && currentPath === '/playlist/create' ? 'active' : '' %>">
                <a href="/playlist/create">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                    Create Playlist
                </a>
            </li>
        <% } %>
    </ul>

    <% if (account.role === 'artist') { %>
    <!-- Artist Menu -->
    <h3 class="sidebar-section-label">Artist Tools</h3>
    <ul>
        <li class="<%= typeof currentPath !== 'undefined' && currentPath === '/songs/upload' ? 'active' : '' %>">
            <a href="/songs/upload">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                Upload Song
            </a>
        </li>
        <li class="<%= typeof currentPath !== 'undefined' && currentPath === '/my-songs' ? 'active' : '' %>">
            <a href="/my-songs">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                Manage Songs
            </a>
        </li>
    </ul>
    <% } %>

    <!-- User's Custom Playlists -->
    <% if (account.role === 'user') { %>
        <% const myPlaylists = typeof userPlaylists !== 'undefined' ? userPlaylists : []; %>
        <% if (myPlaylists && myPlaylists.length > 0) { %>
        <h3 class="sidebar-section-label">Your Playlists</h3>
        <ul class="sidebar-playlist-list">
            <% myPlaylists.forEach(pl => { %>
                <li>
                    <a href="/playlist/<%= pl._id %>" class="sidebar-playlist-item">
                        <div class="sidebar-playlist-dot"></div>
                        <span class="sidebar-playlist-name"><%= pl.name %></span>
                    </a>
                </li>
            <% }); %>
        </ul>
        <% } %>
    <% } %>

</aside>