<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Releases | MusicHub</title>
    <meta name="description" content="Discover the latest new album releases on MusicHub.">
    <link rel="stylesheet" href="/css/style_dashboard.css">
</head>
<body>
<div class="dashboard-container">
    <%- include('partials/sidebar') %>
    <main class="main-content">
        <%- include('partials/header') %>

        <section class="content-area">
            <div class="page-header">
                <h1 style="font-size:1.8rem;font-weight:800;margin:0;">🆕 New Releases</h1>
                <p style="color:var(--text-muted);margin:6px 0 0;">Fresh albums and singles just dropped</p>
            </div>

            <% if (albums && albums.length > 0) { %>
            <div class="feed-tracks-grid" style="margin-top:24px;">
                <% albums.forEach(album => { %>
                    <% if (album) { %>
                    <a href="/album/<%= album.id || 'default_album' %>" class="feed-track-card-link" style="text-decoration:none;color:inherit;display:block;">
                        <div class="feed-track-card">
                            <div class="feed-track-cover">
                                <% if (album.images && album.images.length > 0) { %>
                                    <img src="<%= album.images[0].url %>" alt="<%= album.name %>" loading="lazy" onerror="this.src='https://placehold.co/200x200/0f2038/ffd700?text=Album'">
                                <% } else { %>
                                    <div style="width:100%;aspect-ratio:1;background:var(--bg-surface);display:flex;align-items:center;justify-content:center;font-size:2rem;">💿</div>
                                <% } %>
                                <div class="feed-track-play-overlay">
                                    <svg viewBox="0 0 24 24" width="32" height="32" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                                </div>
                            </div>
                            <div class="feed-track-info">
                                <div class="feed-track-name"><%= album.name %></div>
                                <div class="feed-track-artist">
                                    <% if (album.artists && album.artists.length > 0) { %>
                                        <%= album.artists.map(a => a.name).join(', ') %>
                                    <% } else { %>
                                        Various Artists
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </a>
                    <% } %>
                <% }); %>
            </div>
            <% } else { %>
            <div class="empty-state-card" style="margin-top:40px;">
                <div class="empty-state-icon">💿</div>
                <h3>No New Releases</h3>
                <p>Check back soon for the latest music drops.</p>
                <a href="javascript:history.back()" class="btn-create">← Go Back</a>
            </div>
            <% } %>
        </section>
    </main>
</div>
</body>
</html>